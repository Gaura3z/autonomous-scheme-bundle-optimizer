# Autonomous Scheme-Bundle Optimizer - Environment Variables
# Note: In AI Studio Build, server-side GEMINI_API_KEY is automatically injected when available.

# Server Configuration
PORT=3000

# Gemini API (Server-side proxy at /api/v1/explain)
GEMINI_API_KEY=

# Administrative Portal Authentication (Defaults provided in code if unset)
PS16_ADMIN_USERNAME=admin
PS16_ADMIN_PASSWORD=ps16-demo-admin
PS16_ADMIN_TOKEN_SECRET=local-ps16-change-this-secret
